    "teams_im_in_leave_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sieht deine Routinen und Trainings dann nicht mehr. Mit einer neuen Einladung kannst du wieder beitreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ will no longer see your trainings and workouts. You can join again with a new invite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ya no verá tus rutinas ni tus entrenamientos. Puedes volver a unirte con una invitación nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne verra plus vos routines ni vos séances. Vous pourrez revenir avec une nouvelle invitation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tidak akan bisa lagi melihat program dan latihanmu. Kamu bisa bergabung lagi dengan undangan baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non vedrà più le tue schede e i tuoi allenamenti. Potrai unirti di nuovo con un nuovo invito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@はあなたのトレーニングとワークアウトを見られなくなります。新しい招待で再度参加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@님은 더 이상 내 루틴과 운동을 볼 수 없어요. 새 초대로 다시 참여할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ziet je trainingen en workouts dan niet meer. Je kunt opnieuw lid worden met een nieuwe uitnodiging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nie będzie już widzieć Twoich treningów. Możesz dołączyć ponownie z nowym zaproszeniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não verá mais seus treinos. Você pode entrar de novo com um novo convite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ больше не будет видеть ваши тренировки. Вы сможете присоединиться снова по новому приглашению."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ artık programlarını ve antrenmanlarını göremez. Yeni bir davetle tekrar katılabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ більше не бачитиме ваших тренувань. Ви зможете приєднатися знову за новим запрошенням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@将无法再查看你的训练计划和训练记录。你可以通过新的邀请重新加入。"
          }
        }
      }
    },
