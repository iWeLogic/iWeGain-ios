    "workout_switch_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst Übungen und Sätze hinzufügen. Deine eingetragenen Sätze bleiben. %1$@ selbst ändert sich nicht, und dieses Training wird nicht mit deinen anderen %1$@-Trainings verglichen. Es wird in %2$@ umbenannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ll be able to add exercises and sets. Your logged sets stay. %1$@ itself doesn’t change, and this workout won’t be compared with your other %1$@ workouts. It will be renamed to %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrás añadir ejercicios y series. Tus series registradas se mantienen. %1$@ no cambia, y este entrenamiento no se comparará con tus otros entrenamientos de %1$@. Se renombrará como %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez ajouter des exercices et des séries. Vos séries notées restent. %1$@ ne change pas, et cette séance ne sera pas comparée à vos autres séances %1$@. Elle sera renommée %2$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu bisa menambahkan latihan dan set. Set yang sudah dicatat tetap ada. %1$@ sendiri tidak berubah, dan latihan ini tidak dibandingkan dengan latihan %1$@ lainnya. Namanya akan diubah menjadi %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrai aggiungere esercizi e serie. Le serie registrate restano. %1$@ non cambia e questo allenamento non verrà confrontato con gli altri di %1$@. Verrà rinominato in %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "種目とセットを追加できるようになります。記録したセットはそのまま残ります。%1$@自体は変わらず、このワークアウトは他の%1$@のワークアウトと比較されません。名前は「%2$@」に変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동과 세트를 추가할 수 있습니다. 기록한 세트는 그대로 유지됩니다. %1$@ 자체는 바뀌지 않으며, 이 운동은 다른 %1$@ 운동과 비교되지 않습니다. 이름이 %2$@(으)로 바뀝니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt oefeningen en sets toevoegen. Je gelogde sets blijven. %1$@ zelf verandert niet, en deze training wordt niet vergeleken met je andere %1$@-trainingen. De naam wordt %2$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Będziesz mógł dodawać ćwiczenia i serie. Zapisane serie zostaną. %1$@ się nie zmieni, a ten trening nie będzie porównywany z innymi treningami %1$@. Zmieni nazwę na %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você poderá adicionar exercícios e séries. As séries registradas continuam. %1$@ não muda, e este treino não será comparado com seus outros treinos de %1$@. Ele será renomeado para %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы сможете добавлять упражнения и подходы. Записанные подходы останутся. Сама «%1$@» не изменится, и эта тренировка не будет сравниваться с другими тренировками «%1$@». Она будет переименована в «%2$@»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egzersiz ve set ekleyebileceksin. Kaydettiğin setler kalır. %1$@ değişmez ve bu antrenman diğer %1$@ antrenmanlarınla karşılaştırılmaz. Adı %2$@ olarak değişecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви зможете додавати вправи й підходи. Записані підходи залишаться. Саме «%1$@» не зміниться, і це тренування не порівнюватиметься з іншими тренуваннями «%1$@». Його буде перейменовано на «%2$@»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将可以添加动作和组，已记录的组会保留。%1$@本身不会改变，本次训练也不会与其他%1$@训练进行比较。它将被重命名为%2$@。"
          }
        }
      }
    },
