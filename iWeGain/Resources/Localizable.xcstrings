    "add_person_choice_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge den Fortschritt von Freunden, Partner oder Familie neben deinem eigenen. Du wechselst oben auf Start, Statistik und Kalender zwischen Personen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track a friend, partner or family member next to your own progress. You switch between people at the top of Home, Statistics and Calendar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue el progreso de un amigo, tu pareja o un familiar junto al tuyo. Cambias de persona arriba en Inicio, Estadísticas y Calendario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez les progrès d’un ami, d’un partenaire ou d’un proche à côté des vôtres. Vous changez de personne en haut d’Accueil, Statistiques et Calendrier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantau kemajuan teman, pasangan, atau keluarga di samping kemajuanmu. Ganti orang di bagian atas Beranda, Statistik, dan Kalender."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui i progressi di un amico, del partner o di un familiare accanto ai tuoi. Cambi persona in alto in Home, Statistiche e Calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友達やパートナー、家族の進捗を自分と並べて記録できます。ホーム、統計、カレンダーの上部で人を切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구, 파트너, 가족의 진행 상황을 내 기록과 함께 관리하세요. 홈, 통계, 캘린더 상단에서 사람을 전환합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volg de voortgang van een vriend, partner of familielid naast je eigen. Je wisselt van persoon bovenaan Start, Statistieken en Agenda."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledź postępy przyjaciela, partnera lub kogoś z rodziny obok swoich. Osobę zmieniasz u góry ekranów Start, Statystyki i Kalendarz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe o progresso de um amigo, parceiro ou familiar junto ao seu. Você troca de pessoa no topo de Início, Estatísticas e Calendário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживайте прогресс друга, партнёра или члена семьи рядом со своим. Переключайтесь между людьми вверху экранов Главная, Статистика и Календарь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir arkadaşının, partnerinin veya aile üyenin ilerlemesini kendininkiyle birlikte takip et. Kişiler arasında Ana Sayfa, İstatistikler ve Takvim’in üstünden geçiş yaparsın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відстежуйте прогрес друга, партнера чи члена родини поруч зі своїм. Перемикайтеся між людьми вгорі екранів Головна, Статистика й Календар."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在自己的进度旁记录朋友、伴侣或家人的进度。在首页、统计和日历顶部切换人员。"
          }
        }
      }
    },
