    "profile_delete_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainings, Workouts und Plan von %1$@ werden aus deinem Konto gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@’s trainings, workouts and schedule will be deleted from your account. This can’t be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los entrenamientos, sesiones y calendario de %1$@ se eliminarán de tu cuenta. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entraînements, séances et le planning de %1$@ seront supprimés de votre compte. Action irréversible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latihan, sesi, dan jadwal %1$@ akan dihapus dari akunmu. Tindakan ini tidak bisa dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allenamenti, sessioni e calendario di %1$@ verranno eliminati dal tuo account. Non si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@のトレーニング、ワークアウト、予定がアカウントから削除されます。元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 트레이닝, 운동, 일정이 계정에서 삭제됩니다. 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainingen, workouts en planning van %1$@ worden uit je account verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treningi, sesje i plan %1$@ zostaną usunięte z Twojego konta. Tego nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os treinos, sessões e agenda de %1$@ serão excluídos da sua conta. Não é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировки, занятия и расписание %1$@ будут удалены из вашего аккаунта. Это нельзя отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ için antrenmanlar, seanslar ve plan hesabından silinecek. Bu geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренування, заняття й розклад %1$@ буде видалено з вашого акаунта. Це не можна скасувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@的训练、锻炼记录和日程将从你的账号中删除，且无法撤销。"
          }
        }
      }
    },
