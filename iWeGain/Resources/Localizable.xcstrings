    "profile_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainings und Workouts werden in deinem Konto gespeichert. Nur du kannst sie sehen und ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Their trainings and workouts are kept in your account. Only you can see and change them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus entrenamientos se guardan en tu cuenta. Solo tú puedes verlos y cambiarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses entraînements et séances sont enregistrés dans votre compte. Vous seul pouvez les voir et les modifier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latihan dan sesinya disimpan di akunmu. Hanya kamu yang bisa melihat dan mengubahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi allenamenti sono salvati nel tuo account. Solo tu puoi vederli e modificarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレーニングとワークアウトはあなたのアカウントに保存され、あなただけが閲覧・変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트레이닝과 운동 기록은 내 계정에 저장되며 나만 보고 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainingen en workouts staan in jouw account. Alleen jij kunt ze zien en wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treningi są zapisywane na Twoim koncie. Tylko Ty możesz je widzieć i zmieniać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os treinos ficam na sua conta. Só você pode vê-los e alterá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его тренировки хранятся в вашем аккаунте. Видеть и менять их можете только вы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenmanları hesabında tutulur. Onları yalnızca sen görebilir ve değiştirebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Її тренування зберігаються у вашому акаунті. Бачити й змінювати їх можете лише ви."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其训练和锻炼记录保存在你的账号中，只有你可以查看和修改。"
          }
        }
      }
    },
