    "add_person_invite_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für jemanden mit eigenem Handy. Die Person meldet sich an, und du siehst ihre Daten, solange sie es erlaubt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
