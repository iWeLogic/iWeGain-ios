    "exercise_change_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du machst gerade %1$@. Kehre dorthin zurück oder wechsle zu dieser Übung: %1$@ wird als übersprungen markiert, und du kannst sie später fortsetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're doing %1$@ right now. Go back to it, or change to this exercise: %1$@ will be marked as skipped, and you can continue it later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora estás haciendo %1$@. Vuelve a él o cambia a este ejercicio: %1$@ se marcará como saltado y podrás continuarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous faites %1$@ en ce moment. Revenez-y, ou passez à cet exercice : %1$@ sera marqué comme passé, et vous pourrez le reprendre plus tard."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu sedang melakukan %1$@. Kembali ke gerakan itu, atau ganti ke gerakan ini: %1$@ akan ditandai dilewati, dan kamu bisa melanjutkannya nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai facendo %1$@. Torna a quello o passa a questo esercizio: %1$@ verrà segnato come saltato e potrai continuarlo più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在%1$@を実施中です。それに戻るか、この種目に変更してください。変更すると%1$@はスキップ扱いになり、後で再開できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 %1$@ 진행 중이에요. 그 종목으로 돌아가거나 이 종목으로 변경하세요. 변경하면 %1$@은(는) 건너뜀으로 표시되며 나중에 이어서 할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je doet nu %1$@. Ga daarnaar terug of wissel naar deze oefening: %1$@ wordt als overgeslagen gemarkeerd en je kunt er later mee verdergaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz wykonujesz: %1$@. Wróć do niego albo przejdź do tego ćwiczenia: %1$@ zostanie oznaczone jako pominięte i będzie można je dokończyć później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está fazendo %1$@ agora. Volte para ele ou troque para este exercício: %1$@ será marcado como pulado, e você pode continuá-lo depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас вы выполняете «%1$@». Вернитесь к нему или перейдите на это упражнение: «%1$@» будет отмечено как пропущенное, и вы сможете продолжить его позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anda %1$@ yapıyorsun. Ona geri dön ya da bu egzersize geç: %1$@ atlandı olarak işaretlenir ve daha sonra devam edebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зараз ви виконуєте «%1$@». Поверніться до неї або змініть на цю вправу: «%1$@» буде позначено як пропущену, і ви зможете продовжити її пізніше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你正在进行%1$@。返回该动作，或更换为当前动作：%1$@将被标记为已跳过，之后可以继续。"
          }
        }
      }
    },
