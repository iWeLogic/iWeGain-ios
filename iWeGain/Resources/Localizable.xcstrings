    "auth_error_account_exists" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This email already has an account. Sign in the way you did before, and this sign-in method will be added to it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese E-Mail gibt es schon ein Konto. Melde dich so an wie beim letzten Mal, dann wird diese Anmeldemethode hinzugefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay una cuenta con este correo. Inicia sesión como lo hiciste antes y se añadirá este método de inicio de sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compte existe déjà avec cette adresse e-mail. Connectez-vous comme la dernière fois et ce mode de connexion y sera ajouté."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Email ini sudah punya akun. Masuk dengan cara yang kamu pakai sebelumnya, lalu metode masuk ini akan ditambahkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiste già un account con questa email. Accedi come hai fatto in precedenza e questo metodo di accesso verrà aggiunto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このメールアドレスのアカウントは既にあります。前回と同じ方法でサインインすると、このサインイン方法が追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이메일로 된 계정이 이미 있어요. 이전에 사용한 방법으로 로그인하면 이 로그인 방법이 추가돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is al een account met dit e-mailadres. Log in zoals je eerder deed, dan wordt deze inlogmethode toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto z tym adresem e-mail już istnieje. Zaloguj się tak jak poprzednio, a ta metoda logowania zostanie do niego dodana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe uma conta com este e-mail. Entre como você fez antes e este método de login será adicionado a ela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт с этой почтой уже есть. Войдите так же, как раньше, и этот способ входа будет добавлен к нему."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu e-postayla zaten bir hesap var. Daha önce nasıl giriş yaptıysan öyle giriş yap, bu giriş yöntemi hesabına eklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акаунт із цією поштою вже існує. Увійдіть так само, як раніше, і цей спосіб входу буде додано до нього."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此邮箱已有账号。请使用你之前的方式登录，此登录方式将被添加到该账号。"
          }
        }
      }
    },
