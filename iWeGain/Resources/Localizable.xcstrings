    "training_delete_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplante Termine werden aus dem Kalender entfernt. Abgeschlossene Trainings bleiben in deinem Verlauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its planned sessions will be removed from the calendar. Finished workouts stay in your history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus sesiones planificadas se quitarán del calendario. Los entrenamientos terminados se quedan en tu historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses séances planifiées seront retirées du calendrier. Les séances terminées restent dans votre historique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi yang direncanakan akan dihapus dari kalender. Latihan yang sudah selesai tetap ada di riwayatmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni pianificate verranno rimosse dal calendario. Gli allenamenti completati restano nella tua cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定されたセッションはカレンダーから削除されます。完了したワークアウトは履歴に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예정된 일정은 캘린더에서 삭제됩니다. 완료한 운동은 기록에 남아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geplande sessies worden uit de kalender verwijderd. Afgeronde workouts blijven in je geschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplanowane sesje zostaną usunięte z kalendarza. Ukończone treningi pozostaną w historii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões planejadas serão removidas do calendário. Os treinos concluídos continuam no seu histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запланированные занятия с ней будут убраны из календаря. Завершённые тренировки останутся в истории."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlanmış seansları takvimden kaldırılır. Tamamlanan antrenmanlar geçmişinde kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заплановані заняття з ним буде прибрано з календаря. Завершені тренування залишаться в історії."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其已安排的训练将从日历中移除。已完成的训练会保留在历史记录中。"
          }
        }
      }
    },
