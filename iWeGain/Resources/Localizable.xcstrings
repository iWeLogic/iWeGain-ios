    "join_team_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kann dann deine Routinen und Trainings sehen und bearbeiten sowie deine Statistik sehen. Du kannst das jederzeit in den Einstellungen beenden oder das Team verlassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ will be able to see and edit your trainings and workouts, and see your statistics. You can stop this or leave the team anytime in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ podrá ver y editar tus rutinas y entrenamientos, y ver tus estadísticas. Puedes quitar el acceso o salir del equipo cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pourra voir et modifier vos routines et vos séances, et voir vos statistiques. Vous pouvez y mettre fin ou quitter l'équipe à tout moment dans Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ akan bisa melihat dan mengedit program dan latihanmu, serta melihat statistikmu. Kamu bisa menghentikannya atau keluar dari tim kapan saja di Setelan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ potrà vedere e modificare le tue schede e i tuoi allenamenti, e vedere le tue statistiche. Puoi revocare l'accesso o lasciare il team in qualsiasi momento in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@はあなたのトレーニングとワークアウトを閲覧・編集でき、統計も見られるようになります。設定からいつでも停止またはチームを退出できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@님이 내 루틴과 운동을 보고 편집하며 통계를 볼 수 있게 됩니다. 설정에서 언제든 중지하거나 팀에서 나갈 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kan je trainingen en workouts bekijken en bewerken en je statistieken zien. Je kunt dit stoppen of het team verlaten wanneer je wilt via Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ będzie mieć możliwość przeglądania i edytowania Twoich treningów oraz wglądu w Twoje statystyki. Możesz to wyłączyć lub opuścić zespół w każdej chwili w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ poderá ver e editar seus treinos e ver suas estatísticas. Você pode desativar isso ou sair da equipe a qualquer momento nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ сможет видеть и редактировать ваши тренировки и просматривать вашу статистику. Вы можете отключить доступ или выйти из команды в любой момент в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ programlarını ve antrenmanlarını görüp düzenleyebilecek, istatistiklerini görebilecek. Bunu istediğin zaman Ayarlar'dan durdurabilir veya takımdan ayrılabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ зможе бачити й редагувати ваші тренування та переглядати вашу статистику. Ви можете вимкнути доступ або вийти з команди будь-коли в Налаштуваннях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@将能够查看和编辑你的训练计划和训练记录，并查看你的统计。你可以随时在设置中停止授权或退出团队。"
          }
        }
      }
    },
