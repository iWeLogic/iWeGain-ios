        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij wordt uit je geschiedenis en statistieken verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostanie usunięty z historii i statystyk. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele será removido do seu histórico e das estatísticas. Não é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Она будет убрана из истории и статистики. Это нельзя отменить."
