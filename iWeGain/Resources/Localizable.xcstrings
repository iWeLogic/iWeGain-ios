    "settings_log_out_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Trainings, Routinen und Einstellungen bleiben in deinem Konto und sind nach der nächsten Anmeldung wieder da. Noch nicht synchronisierte Änderungen gehen verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your workouts, trainings and settings stay in your account and will come back when you sign in again. Changes that haven't synced yet will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus entrenamientos, rutinas y ajustes se quedan en tu cuenta y volverán cuando inicies sesión de nuevo. Los cambios que aún no se hayan sincronizado se perderán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos séances, routines et réglages restent dans votre compte et reviendront à votre prochaine connexion. Les modifications pas encore synchronisées seront perdues."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latihan, program, dan setelanmu tetap tersimpan di akunmu dan akan kembali saat kamu masuk lagi. Perubahan yang belum disinkronkan akan hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allenamenti, schede e impostazioni restano nel tuo account e torneranno quando accederai di nuovo. Le modifiche non ancora sincronizzate andranno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウト、トレーニング、設定はアカウントに保存され、再度ログインすると復元されます。まだ同期されていない変更は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동, 루틴, 설정은 계정에 남아 있으며 다시 로그인하면 복원됩니다. 아직 동기화되지 않은 변경사항은 사라져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je workouts, trainingen en instellingen blijven in je account en komen terug als je opnieuw inlogt. Wijzigingen die nog niet zijn gesynchroniseerd, gaan verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje treningi i ustawienia pozostaną na koncie i wrócą po ponownym zalogowaniu. Niezsynchronizowane zmiany zostaną utracone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus treinos e ajustes ficam salvos na sua conta e voltam quando você entrar de novo. Alterações ainda não sincronizadas serão perdidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши тренировки, планы и настройки останутся в аккаунте и вернутся, когда вы снова войдёте. Изменения, которые ещё не синхронизированы, будут потеряны."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenmanların, programların ve ayarların hesabında kalır ve tekrar giriş yaptığında geri gelir. Henüz senkronize edilmemiş değişiklikler kaybolur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші тренування, плани та налаштування залишаться в акаунті й повернуться, коли ви знову ввійдете. Зміни, які ще не синхронізовано, буде втрачено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的训练记录、训练计划和设置会保留在账号中，再次登录后即可恢复。尚未同步的更改将会丢失。"
          }
        }
      }
    },
