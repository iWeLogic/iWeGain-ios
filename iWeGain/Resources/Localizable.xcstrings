    "settings_delete_account_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto und alle deine Trainings, Routinen und Einstellungen werden auf allen Geräten gelöscht, und du verlässt alle Teams. Das kann nicht rückgängig gemacht werden. Wähle zur Bestätigung dein Google-Konto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account and all your workouts, trainings and settings will be deleted from every device, and you will leave all teams. This can't be undone. To confirm, choose your Google account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta y todos tus entrenamientos, rutinas y ajustes se eliminarán de todos los dispositivos, y saldrás de todos los equipos. No se puede deshacer. Para confirmar, elige tu cuenta de Google."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte et toutes vos séances, routines et réglages seront supprimés de tous vos appareils, et vous quitterez toutes les équipes. Cette action est irréversible. Pour confirmer, choisissez votre compte Google."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akunmu beserta semua latihan, program, dan setelan akan dihapus dari semua perangkat, dan kamu akan keluar dari semua tim. Tindakan ini tidak bisa dibatalkan. Untuk konfirmasi, pilih akun Google-mu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account e tutti i tuoi allenamenti, schede e impostazioni verranno eliminati da tutti i dispositivi, e uscirai da tutti i team. L'operazione non può essere annullata. Per confermare, scegli il tuo account Google."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントとすべてのワークアウト、トレーニング、設定がすべてのデバイスから削除され、すべてのチームから退出します。この操作は元に戻せません。確認のため、Google アカウントを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정과 모든 운동, 루틴, 설정이 모든 기기에서 삭제되며 모든 팀에서 나가게 됩니다. 이 작업은 되돌릴 수 없어요. 확인하려면 Google 계정을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account en al je workouts, trainingen en instellingen worden van elk apparaat verwijderd en je verlaat alle teams. Dit kan niet ongedaan worden gemaakt. Kies je Google-account om te bevestigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto oraz wszystkie treningi i ustawienia zostaną usunięte ze wszystkich urządzeń, a Ty opuścisz wszystkie zespoły. Tej operacji nie można cofnąć. Aby potwierdzić, wybierz swoje konto Google."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta e todos os seus treinos e ajustes serão excluídos de todos os dispositivos, e você sairá de todas as equipes. Não é possível desfazer. Para confirmar, escolha sua Conta do Google."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш аккаунт и все тренировки, планы и настройки будут удалены со всех устройств, а вы выйдете из всех команд. Это нельзя отменить. Чтобы подтвердить, выберите свой аккаунт Google."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabın ve tüm antrenmanların, programların ve ayarların her cihazdan silinir ve tüm takımlardan ayrılırsın. Bu işlem geri alınamaz. Onaylamak için Google hesabını seç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш акаунт і всі тренування, плани та налаштування буде видалено з усіх пристроїв, а ви вийдете з усіх команд. Це не можна скасувати. Щоб підтвердити, виберіть свій акаунт Google."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的账号以及所有训练记录、训练计划和设置都将从所有设备中删除，并且你将退出所有团队。此操作无法撤销。请选择你的 Google 账号以确认。"
          }
        }
      }
    },
    "settings_delete_account_message_apple" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto und alle deine Trainings, Routinen und Einstellungen werden auf allen Geräten gelöscht, und du verlässt alle Teams. Das kann nicht rückgängig gemacht werden. Melde dich zur Bestätigung mit deinem Apple Account an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account and all your workouts, trainings and settings will be deleted from every device, and you will leave all teams. This can't be undone. To confirm, sign in with your Apple Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta y todos tus entrenamientos, rutinas y ajustes se eliminarán de todos los dispositivos, y saldrás de todos los equipos. No se puede deshacer. Para confirmar, inicia sesión con tu cuenta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte et toutes vos séances, routines et réglages seront supprimés de tous vos appareils, et vous quitterez toutes les équipes. Cette action est irréversible. Pour confirmer, connectez-vous avec votre compte Apple."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akunmu beserta semua latihan, program, dan setelan akan dihapus dari semua perangkat, dan kamu akan keluar dari semua tim. Tindakan ini tidak bisa dibatalkan. Untuk konfirmasi, masuk dengan Akun Apple-mu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account e tutti i tuoi allenamenti, schede e impostazioni verranno eliminati da tutti i dispositivi, e uscirai da tutti i team. L'operazione non può essere annullata. Per confermare, accedi con il tuo Account Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントとすべてのワークアウト、トレーニング、設定がすべてのデバイスから削除され、すべてのチームから退出します。この操作は元に戻せません。確認のため、Apple アカウントでサインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정과 모든 운동, 루틴, 설정이 모든 기기에서 삭제되며 모든 팀에서 나가게 됩니다. 이 작업은 되돌릴 수 없어요. 확인하려면 Apple 계정으로 로그인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account en al je workouts, trainingen en instellingen worden van elk apparaat verwijderd en je verlaat alle teams. Dit kan niet ongedaan worden gemaakt. Log in met je Apple Account om te bevestigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto oraz wszystkie treningi i ustawienia zostaną usunięte ze wszystkich urządzeń, a Ty opuścisz wszystkie zespoły. Tej operacji nie można cofnąć. Aby potwierdzić, zaloguj się na swoje konto Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta e todos os seus treinos e ajustes serão excluídos de todos os dispositivos, e você sairá de todas as equipes. Não é possível desfazer. Para confirmar, inicie sessão com sua Conta Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш аккаунт и все тренировки, планы и настройки будут удалены со всех устройств, а вы выйдете из всех команд. Это нельзя отменить. Чтобы подтвердить, войдите со своим аккаунтом Apple."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabın ve tüm antrenmanların, programların ve ayarların her cihazdan silinir ve tüm takımlardan ayrılırsın. Bu işlem geri alınamaz. Onaylamak için Apple Hesabınla giriş yap."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш акаунт і всі тренування, плани та налаштування буде видалено з усіх пристроїв, а ви вийдете з усіх команд. Це не можна скасувати. Щоб підтвердити, увійдіть зі своїм акаунтом Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的账号以及所有训练记录、训练计划和设置都将从所有设备中删除，并且你将退出所有团队。此操作无法撤销。请使用你的 Apple 账户登录以确认。"
          }
        }
      }
    },
