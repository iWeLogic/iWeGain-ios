        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitará de tu historial y tus estadísticas. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle sera retirée de votre historique et de vos statistiques. Cette action est irréversible."
