    "my_team_remove_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Person verschwindet aus deiner Liste und du siehst ihre Trainings nicht mehr. Ihre Daten bleiben in ihrem eigenen Konto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They will disappear from your list and you will no longer see their workouts. Their data stays in their own account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desaparecerá de tu lista y ya no verás sus entrenamientos. Sus datos se quedan en su propia cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personne disparaîtra de votre liste et vous ne verrez plus ses séances. Ses données restent dans son propre compte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mereka akan hilang dari daftarmu dan kamu tidak bisa lagi melihat latihan mereka. Data mereka tetap ada di akun mereka sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scomparirà dal tuo elenco e non vedrai più i suoi allenamenti. I suoi dati restano nel suo account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストから削除され、その人のワークアウトは見られなくなります。データは本人のアカウントに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록에서 사라지며 더 이상 운동 기록을 볼 수 없어요. 데이터는 본인 계정에 남아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diegene verdwijnt uit je lijst en je ziet hun workouts niet meer. Hun gegevens blijven in hun eigen account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta osoba zniknie z Twojej listy i nie zobaczysz już jej treningów. Jej dane pozostaną na jej własnym koncie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pessoa sumirá da sua lista e você não verá mais os treinos dela. Os dados dela continuam na própria conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Человек исчезнет из вашего списка, и вы больше не будете видеть его тренировки. Его данные останутся в его аккаунте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listenden kaybolur ve antrenmanlarını artık göremezsin. Verileri kendi hesabında kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Людина зникне з вашого списку, і ви більше не бачитимете її тренувань. Її дані залишаться в її обліковому записі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对方将从你的列表中消失，你将无法再查看其训练记录。对方的数据仍保留在其账号中。"
          }
        }
      }
    },
