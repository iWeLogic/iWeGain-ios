    "settings_teams_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen, die du trainierst, erscheinen in deiner Liste auf Start, Statistik und Kalender. Teamleiter, denen du es erlaubst, können deine Routinen und Trainings sehen und ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People you train appear in your list on Home, Statistics and Calendar. Team leaders you allow can see and change your trainings and workouts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las personas que entrenas aparecen en tu lista en Inicio, Estadísticas y Calendario. Los líderes de equipo a los que des permiso pueden ver y cambiar tus rutinas y entrenamientos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes que vous entraînez apparaissent dans votre liste sur Accueil, Statistiques et Calendrier. Les chefs d'équipe que vous autorisez peuvent voir et modifier vos routines et vos séances."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang kamu latih muncul di daftarmu di Beranda, Statistik, dan Kalender. Pemimpin tim yang kamu izinkan bisa melihat dan mengubah program dan latihanmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le persone che alleni compaiono nel tuo elenco in Home, Statistiche e Calendario. I team leader a cui dai il permesso possono vedere e modificare le tue schede e i tuoi allenamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたが指導する人は、ホーム、統計、カレンダーのリストに表示されます。許可したチームリーダーは、あなたのトレーニングとワークアウトを閲覧・変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내가 지도하는 사람들은 홈, 통계, 캘린더 목록에 표시돼요. 허용한 팀 리더는 내 루틴과 운동을 보고 변경할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensen die je traint verschijnen in je lijst op Home, Statistieken en Kalender. Teamleiders die je toestemming geeft, kunnen je trainingen en workouts bekijken en wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoby, które trenujesz, pojawiają się na Twojej liście na ekranach Start, Statystyki i Kalendarz. Liderzy zespołów, którym na to pozwolisz, mogą widzieć i zmieniać Twoje treningi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pessoas que você treina aparecem na sua lista em Início, Estatísticas e Calendário. Os líderes de equipe que você permitir podem ver e alterar seus treinos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Люди, которых вы тренируете, появляются в вашем списке на Главной, в Статистике и Календаре. Тренеры, которым вы разрешите, могут видеть и изменять ваши тренировки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalıştırdığın kişiler Ana Sayfa, İstatistikler ve Takvim'deki listende görünür. İzin verdiğin takım liderleri programlarını ve antrenmanlarını görebilir ve değiştirebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Люди, яких ви тренуєте, з’являються у вашому списку на Головній, у Статистиці та Календарі. Тренери, яким ви дозволите, можуть бачити й змінювати ваші тренування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你指导的人会显示在首页、统计和日历的列表中。你授权的团队负责人可以查看和更改你的训练计划和训练记录。"
          }
        }
      }
    },
