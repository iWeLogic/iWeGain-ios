    "teams_im_in_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teamleiter, denen du es erlaubst, können deine Routinen, Trainings und deinen Plan sehen und ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Team leaders you allow can see and change your trainings, workouts and schedule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los líderes de equipo a los que des permiso pueden ver y cambiar tus rutinas, entrenamientos y agenda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chefs d'équipe que vous autorisez peuvent voir et modifier vos routines, vos séances et votre planning."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemimpin tim yang kamu izinkan bisa melihat dan mengubah program, latihan, dan jadwalmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I team leader a cui dai il permesso possono vedere e modificare le tue schede, i tuoi allenamenti e il tuo programma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可したチームリーダーは、あなたのトレーニング、ワークアウト、スケジュールを閲覧・変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용한 팀 리더는 내 루틴, 운동, 일정을 보고 변경할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teamleiders die je toestemming geeft, kunnen je trainingen, workouts en planning bekijken en wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liderzy zespołów, którym na to pozwolisz, mogą widzieć i zmieniać Twoje treningi i harmonogram."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os líderes de equipe que você permitir podem ver e alterar seus treinos e sua agenda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренеры, которым вы разрешите, могут видеть и изменять ваши тренировки и расписание."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin verdiğin takım liderleri programlarını, antrenmanlarını ve planını görebilir ve değiştirebilir."
